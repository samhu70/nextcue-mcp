# Merge this table into ~/.codex/config.toml; do not replace the entire file.
# Replace the hostname and both absolute paths before enabling the connection.
[mcp_servers.nextcue]
url = "https://nextcue.example.com/mcp"
http_headers_helper = '"/absolute/path/to/python3" "/absolute/path/to/nextcue-mcp/nextcue_mcp_headers.py"'
enabled = true
